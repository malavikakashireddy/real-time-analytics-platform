# Local demonstration only. Choose a unique password without URL-reserved characters,
# or percent-encode it in DATABASE_URL. Replace both placeholders consistently.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql://analytics:replace-with-local-password@localhost:5432/analytics
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=analytics-events
KAFKA_GROUP_ID=analytics-consumer-v4
